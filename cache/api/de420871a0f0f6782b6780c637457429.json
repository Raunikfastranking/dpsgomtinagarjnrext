f; --tw-ring-color: rgb(59 130 246 \/ 0.5); --tw-ring-offset-shadow: 0 0 #0000; --tw-ring-shadow: 0 0 #0000; --tw-shadow: 0 0 #0000; --tw-shadow-colored: 0 0 #0000; --tw-blur: ; --tw-brightness: ; --tw-contrast: ; --tw-grayscale: ; --tw-hue-rotate: ; --tw-invert: ; --tw-saturate: ; --tw-sepia: ; --tw-drop-shadow: ; --tw-backdrop-blur: ; --tw-backdrop-brightness: ; --tw-backdrop-contrast: ; --tw-backdrop-grayscale: ; --tw-backdrop-hue-rotate: ; --tw-backdrop-invert: ; --tw-backdrop-opacity: ; --tw-backdrop-saturate: ; --tw-backdrop-sepia: ; --tw-contain-size: ; --tw-contain-layout: ; --tw-contain-paint: ; --tw-contain-style: ; border-width: 0px; border-style: solid; border-color: rgb(229, 231, 235); margin-top: 0.5rem; margin-bottom: 0px; --tw-text-opacity: 1; color: rgb(75, 85, 99); font-family: ui-sans-serif, system-ui, sans-serif, &quot;Apple Color Emoji&quot;, &quot;Segoe UI Emoji&quot;, &quot;Segoe UI Symbol&quot;, &quot;Noto Color Emoji&quot;; font-size: medium;\">As a premier educational institution, we are known for creating our own benchmarks and elevating ourselves to higher planes. This practice has made our group schools excellent centres of&nbsp;learning.<\/p>","content_type":"text","image_path":null,"image_url":null,"link_url":null,"video_path":null,"video_url":null,"table_data":null,"accordion_data":null,"order":1,"is_active":true,"created_at":"2025-09-20T01:16:38.420000Z","updated_at":"2025-09-20T01:16:38.420000Z","page_section_id":"811","content_heading":null,"alignment":null,"image_alt":null,"column_type":null,"width":"50","image_width":null,"image_height":null,"content_item_id":null,"content_item_type":null},{"id":396,"title":"Chairman's Message Image Section Gomtinagar Jnr","content":"<h2 class=\"font-[600]\" style=\"--tw-border-spacing-x: 0; --tw-border-spacing-y: 0; --tw-translate-x: 0; --tw-translate-y: 0; --tw-rotate: 0; --tw-skew-x: 0; --tw-skew-y: 0; --tw-scale-x: 1; --tw-scale-y: 1; --tw-pan-x: ; --tw-pan-y: ; --tw-pinch-zoom: ; --tw-scroll